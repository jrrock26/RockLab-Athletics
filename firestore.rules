rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userData().role;
    }

    function schoolId() {
      return userData().schoolId;
    }

    // NOTE: This is a baseline. Role-based custom claims (via Cloud Functions)
    // and per-collection scoping will harden these in later phases.

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || role() == 'ad');
      allow create: if signedIn() && request.auth.uid == userId;
      // A user can edit their own profile but cannot self-promote role or change school.
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == userData().role
          && request.resource.data.schoolId == userData().schoolId)
        || role() == 'ad'
      );
      allow delete: if false;
    }

    match /schools/{school} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adUserId == request.auth.uid;
      allow update: if signedIn() && role() == 'ad' && schoolId() == school;
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if signedIn() && role() == 'ad';
      allow create: if signedIn() && role() == 'ad';
      allow update: if signedIn() && role() == 'ad';
      allow delete: if signedIn() && role() == 'ad';
    }
  }
}
