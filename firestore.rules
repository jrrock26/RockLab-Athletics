rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    /// Role, or '' when the account has no profile document yet.
    ///
    /// `get()` returns null for a document that does not exist, and `.role` on null is
    /// an ERROR, not false. An error inside the first operand of an `||` aborts the
    /// whole rule, so a signed-in account that had not written its profile would be
    /// denied operations a later operand would have granted. Returning '' makes it a
    /// plain false. One `let` also keeps this to a single read where the old body
    /// could pay for two.
    function role() {
      let u = userData();
      return u != null && 'role' in u ? u.role : '';
    }

    function membership(t) {
      return exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid)).data : null;
    }
    function memberRole(t) { return membership(t) == null ? null : membership(t).role; }

    /// The school this user belongs to, or '' if unattached.
    ///
    /// Same null-safety as `role()`: no profile document means '', which matches no
    /// school, instead of an error that takes a whole rule with it.
    function mySchoolId() {
      let u = userData();
      return u != null && 'schoolId' in u && u.schoolId is string ? u.schoolId : '';
    }

    /// AD standing IN ONE SCHOOL.
    ///
    /// `role` is written by the client (onboarding sets it right after creating the
    /// school), so a bare `role() == 'ad'` is self-grantable: any signed-in account
    /// could write role 'ad' to its own document. Standing therefore means "this
    /// school names me as its AD" -- asked about a SPECIFIC school, passed in.
    ///
    /// Why the argument matters: `isAd()` answers "do I own some school". Used on a
    /// path that reads another document, that let an AD of one school read every
    /// user, report and invitation in the district. A rule about another document
    /// must pass THAT document's school.
    ///
    /// `is string` keeps a document with no `schoolId` from erroring the whole rule:
    /// a missing field yields false and denies, where a bare comparison raises and
    /// takes the rest of the evaluation with it.
    function isAdOf(schoolId) {
      return signedIn()
        && schoolId is string
        && schoolId != ''
        && role() == 'ad'
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.adUserId == uid();
    }

    // There is deliberately no `isAd()` here any more.
    //
    // It answered "am I AD of SOME school", and every rule that asked it about
    // another document granted that AD access across district lines. Ownership is
    // now always named: `isAdOf(teamSchool(teamId))`, `isAdOf(schoolId)` from the
    // path, or `isAdOf(resource.data.schoolId)`. Do not reintroduce a bare predicate.

    /// The school that owns a team, or '' when no such team exists.
    ///
    /// Trips, fundraisers and reports carry `teamId` and no `schoolId` (the report
    /// function writes no school today), so their school has to be resolved through
    /// the team. Returning '' instead of erroring means a document with no team -- a
    /// profile report, say -- simply matches no AD; it does not break the rule.
    function teamSchool(t) {
      return t != '' && exists(/databases/$(database)/documents/teams/$(t))
        ? get(/databases/$(database)/documents/teams/$(t)).data.get('schoolId', '')
        : '';
    }
    /// The school that owns a player identity, or '' when there is no such player.
    ///
    /// Guardianship rows live under the player, not under a team, so their ownership
    /// has to be resolved through that document rather than assumed from the caller.
    function playerSchool(p) {
      return p != '' && exists(/databases/$(database)/documents/players/$(p))
        ? get(/databases/$(database)/documents/players/$(p)).data.get('schoolId', '')
        : '';
    }
    function isCoachOf(t) { return memberRole(t) == 'coach'; }
    function isStaffOf(t) { return memberRole(t) == 'staff'; }
    function isTeamMember(t) { return memberRole(t) in ['coach','staff','player','parent']; }
    /// The team a showcase card belongs to, or '' when the card is gone.
    function showcaseTeam(s) {
      return s != '' && exists(/databases/$(database)/documents/showcases/$(s))
        ? get(/databases/$(database)/documents/showcases/$(s)).data.get('teamId', '')
        : '';
    }
    function canManageTeam(t) { return isAdOf(teamSchool(t)) || isCoachOf(t); }
    function staffHasPerm(t, p) {
      let m = membership(t);
      return m != null && m.role == 'staff' && 'permissions' in m && m.permissions.hasAny([p]);
    }

    /// Per-game scoring grant: a parent or student who claimed one game's
    /// statistician request. Deliberately game-scoped — it must not confer
    /// season-long staff standing.
    function isGameScorer(g) {
      return signedIn()
        && exists(/databases/$(database)/documents/games/$(g)/scorers/$(request.auth.uid));
    }

    function eventTeam(id) { return get(/databases/$(database)/documents/events/$(id)).data.teamId; }
    function gameTeam(id) { return get(/databases/$(database)/documents/games/$(id)).data.teamId; }
    function fundTeam(id) { return get(/databases/$(database)/documents/fundraisers/$(id)).data.teamId; }
    function chatDoc(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function conversationDoc(id) { return get(/databases/$(database)/documents/conversations/$(id)).data; }
    function rosterEntryData(teamId, entryId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/roster/$(entryId)).data;
    }
    /// Whether the caller is a guardian of this athlete, judged ONLY on markers a
    /// client cannot forge.
    ///
    ///   - `entry.guardianUserIds` — UIDs, written by acceptInvitation server-side,
    ///     and roster entries are writable only by coaches/AD. This is the
    ///     authority.
    ///   - `users.linkedPlayerIds` — CLIENT-WRITABLE (see the users rule: self
    ///     update is not field-restricted), so it may only be trusted when it
    ///     already names the athlete's own uid. That keeps legacy
    ///     linkedPlayerIds rows working without letting anyone claim an athlete
    ///     by quoting a roster entry id, which is visible in invite links and
    ///     page URLs.
    ///
    /// Deliberately NOT matched: a roster entry id inside linkedPlayerIds. It is
    /// what acceptInvitation stores, but it is also the one value a hostile
    /// account can guess or copy, so it cannot confer standing.
    function linkedToAthlete(entry) {
      let playerUid = entry != null && 'userId' in entry ? entry.userId : null;
      let marked = entry != null && 'guardianUserIds' in entry
        && request.auth.uid in entry.guardianUserIds;
      let u = userData();
      let linked = u != null && 'linkedPlayerIds' in u ? u.linkedPlayerIds : [];
      return entry != null
        && (marked || (playerUid != null && linked.hasAny([playerUid])));
    }

    /// The athlete themselves, or someone authorised for them. Write access to a
    /// submission hangs off this, and the status pin on the calling rule keeps a
    /// guardian from marking their own paperwork approved.
    function isRosterAssignee(teamId, entryId) {
      let entry = rosterEntryData(teamId, entryId);
      let playerUid = entry != null && 'userId' in entry ? entry.userId : null;
      return linkedToAthlete(entry)
        || (playerUid != null && request.auth.uid == playerUid);
    }

    /// The athlete themselves. A player MAY e-sign their own forms — but only their
    /// own signature fields, and only completes a form when it does not require a
    /// guardian signature or the guardian has already signed.
    function isAthleteSelf(teamId, entryId) {
      let entry = rosterEntryData(teamId, entryId);
      return entry != null && 'userId' in entry && request.auth.uid == entry.userId;
    }

    /// The guardian of a specific athlete — linked to them, but NOT the athlete
    /// themselves. A minor cannot authorise their own release.
    ///
    /// This is deliberately the ONLY route by which a form can be submitted, and it
    /// is why `isRosterAssignee` is no longer used for form writes: that predicate is
    /// true for the athlete too, so a 15-year-old could submit their own physical and
    /// concussion waiver. The athlete's own act is an acknowledgement, which is a
    /// different field and a different feature.
    function isGuardianOf(teamId, entryId) {
      let entry = rosterEntryData(teamId, entryId);
      let playerUid = entry != null && 'userId' in entry ? entry.userId : null;
      return linkedToAthlete(entry)
        && (playerUid == null || request.auth.uid != playerUid);
    }

    function isMemberRole(t) {
      return memberRole(t) in ['coach','staff','player','parent'];
    }

    function chatReadAllowed(type, t) {
      return isAdOf(teamSchool(t))
        || (type == 'commBoard' && (isMemberRole(t) || memberRole(t) == 'follower'))
        || (type == 'team' && memberRole(t) in ['coach','staff','player'])
        || (type == 'parent' && memberRole(t) in ['coach','player','parent'])
        || (type == 'staff' && (isAdOf(teamSchool(t)) || isCoachOf(t) || staffHasPerm(t, 'staffChat')));
    }

    // Followers only see public comm-board categories (live game / gameday / fundraiser).
    function messageReadAllowed(type, t) {
      return type == 'commBoard'
        ? (isAdOf(teamSchool(t))
            || isMemberRole(t)
            || (memberRole(t) == 'follower'
                && 'category' in resource.data
                && resource.data.category in ['liveGame', 'gameday', 'fundraiser']))
        : chatReadAllowed(type, t);
    }
    function chatWriteAllowed(type, t) {
      return isAdOf(teamSchool(t))
        || (type == 'commBoard' && (canManageTeam(t) || staffHasPerm(t, 'commBoardPost')))
        || (type == 'team' && memberRole(t) in ['coach','staff','player'])
        || (type == 'parent' && memberRole(t) in ['coach','player','parent'])
        || (type == 'staff' && (isAdOf(teamSchool(t)) || isCoachOf(t) || staffHasPerm(t, 'staffChat')));
    }

    match /users/{userId} {
      // Your own record, an AD of THIS document's school, or staff of the same
      // school. Previously any user claiming role coach/staff could read every
      // document in this collection; the same-school check confines that.
      //
      // The AD branch passes the school named by the document being read, not the
      // caller's own: a bare `isAd()` here let any AD read every guardian's email and
      // phone number in every school.
      allow read: if signedIn() && (
        uid() == userId
        || isAdOf(resource.data.get('schoolId', ''))
        || (role() in ['coach','staff'] && mySchoolId() != '' && mySchoolId() == resource.data.get('schoolId', ''))
      );

      // Self-signup may claim an unprivileged role. Claiming 'ad' requires the
      // school in the same write to already name this user as its AD — which is
      // exactly what onboarding creates a moment earlier.
      //
      // `schoolId` may NOT be asserted by a self-signup. It is the field several rules use
      // to decide what a stranger may read, and a client that chooses its own schoolId can
      // claim membership of any school in the list. Membership of a school is assigned by
      // that school — through an invitation, an approved join request, or an AD — never
      // written by the account itself.
      allow create: if signedIn() && uid() == userId && (
        (request.resource.data.role in ['follower','player','parent','coach']
          && (!('schoolId' in request.resource.data) || request.resource.data.schoolId == ''))
        || (request.resource.data.role == 'ad'
            && request.resource.data.schoolId is string
            && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
            && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.adUserId == uid())
      );

      // A role may only become 'ad' when the write proves school ownership. The
      // check reads the incoming schoolId because onboarding sets role and
      // schoolId together, before the stored document has a school at all.
      //
      // For every other self-edit `schoolId` is frozen. This is the fix for a real
      // escalation: the role list below allows an account to call itself a coach, and
      // `role() in ['coach','staff'] && mySchoolId() == resource.data.schoolId` is what
      // grants reading users and players in a school. Without this clause, any signed-in
      // account could set role coach AND a victim school's id in one write and read that
      // school's children.
      allow update: if signedIn() && (
        (uid() == userId && (
          (request.resource.data.get('role', resource.data.get('role', '')) == 'ad'
            && request.resource.data.schoolId is string
            && request.resource.data.schoolId != ''
            && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
            && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.adUserId == uid())
          || (
            (!('role' in request.resource.data)
              || request.resource.data.role == resource.data.get('role', '')
              || request.resource.data.role in ['follower','player','parent','coach'])
            && (!('schoolId' in request.resource.data)
              || request.resource.data.schoolId == resource.data.get('schoolId', ''))
          )
        ))
        // Editing someone else's document is an AD power, but only over the school
        // that document belongs to.
        || isAdOf(resource.data.get('schoolId', ''))
      );
      allow delete: if false;
    }

    // Durable player identities. ONE record per child for their whole school career,
    // created by the school (AD/coach/staff, manual or imported) and never by a family:
    // the school's directory is the authority and the platform mirrors it.
    //
    // Not enumerable. There is no list or search path for ordinary users, because a
    // searchable directory of children is a safeguarding problem, not a feature.
    match /players/{playerId} {
      function isMySchool() {
        return signedIn() && mySchoolId() != ''
          && 'schoolId' in resource.data && resource.data.schoolId == mySchoolId();
      }
      function isGuardian() {
        return signedIn() && exists(
          /databases/$(database)/documents/players/$(playerId)/guardians/$(request.auth.uid));
      }

      allow read: if signedIn() && (
        isAdOf(resource.data.get('schoolId', ''))
        || isGuardian()
        || ('claimedByUserId' in resource.data && resource.data.claimedByUserId == request.auth.uid)
        || (role() in ['coach', 'staff'] && isMySchool())
      );

      // Creation mirrors the school: staff may only mint a player inside their own
      // school, so one school cannot create profiles in another.
      allow create: if signedIn() && role() in ['ad', 'coach', 'staff']
        && mySchoolId() != ''
        && request.resource.data.schoolId == mySchoolId();

      // Guardians REQUEST profile changes; they never write the player record. Their
      // own contact details live on their user document, which they already edit.
      //
      // `claimedByUserId` and `claimCode` are frozen here even for staff. Both are decided
      // by the claim callables, which write with admin credentials and therefore do not
      // need this rule. Without the freeze a coach could attach any account to a child's
      // profile in one write, which is the exact thing the claim flow exists to prevent.
      // `get(field, null)` rather than `data.field`: players created before claim codes
      // existed have no claimCode, and a missing field would otherwise deny every edit.
      allow update: if signedIn() && (isAdOf(resource.data.get('schoolId', '')) || (role() in ['coach', 'staff'] && isMySchool()))
        && request.resource.data.get('claimedByUserId', null) == resource.data.get('claimedByUserId', null)
        && request.resource.data.get('claimCode', null) == resource.data.get('claimCode', null);
      allow delete: if false;

      // Guardianship is granted by the school, not claimed by the guardian: the link is
      // the approval, so a parent cannot add themselves to a child.
      match /guardians/{guardianId} {
        allow read: if signedIn() && (
          guardianId == request.auth.uid || isAdOf(playerSchool(playerId)) || (role() in ['coach', 'staff'] && isMySchool())
        );
        allow create, delete: if signedIn() && (isAdOf(playerSchool(playerId)) || role() in ['coach', 'staff'])
          && mySchoolId() != ''
          && get(/databases/$(database)/documents/players/$(playerId)).data.schoolId == mySchoolId();
        allow update: if false;
      }
    }

    // Legacy identity keys mapped onto a durable player. Server-written only, so the
    // alias table that stitches a child's history together cannot be forged.
    match /playerAliases/{aliasKey} {
      allow read: if false;
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adUserId == uid();
      // Only the owner edits or deletes their school. Previously any self-declared
      // AD could edit every school.
      allow update, delete: if signedIn() && resource.data.adUserId == uid();

      // Following an ORGANIZATION, not an individual team. A follower manages
      // their own row; the school's AD can see who follows them.
      match /followers/{followerId} {
        allow read: if signedIn() && (uid() == followerId
          || (isAdOf(schoolId) && userData().schoolId == schoolId));
        allow create, delete: if signedIn() && uid() == followerId;
        allow update: if false;
      }

      // A season is an object because a string cannot be CLOSED, and "show me the 2025
      // season" is unanswerable without one.
      //
      // All writes go through callables on purpose: closing a season stamps every roster
      // entry in the school, and that cannot be done transactionally from a browser.
      // Read is open to any signed-in user -- a season is not private data -- and must
      // never be gated on exists(), or the seasons list becomes unlistable.
      match /seasons/{seasonId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Claim requests live under the school rather than at the top level so the read rule
      // can authorise staff from the PATH alone. A top-level collection would have to read
      // `resource.data.schoolId` to answer "is this my school", and a rule that reads the
      // document cannot authorise a list query -- the trap that has broken four reads here.
      //
      // The requester branch does read the document, so an athlete fetches their one request
      // by id (returned by requestPlayerClaim) instead of listing. That is deliberate: a
      // claimant has no business enumerating a school's claim queue.
      //
      // All writes go through the callables, which verify the approver against guardians,
      // AD ownership and staff membership. `create` is false so a client cannot file a
      // request naming a player it could not otherwise see.
      // School records: a directory of best-ever marks, and the custom stats a school
      // invents for itself.
      //
      // Reads are open to any signed-in account. A record book is a public-facing thing --
      // it is the page a school puts in the gym lobby -- so there is nothing here that needs
      // hiding, and an open read keeps list queries authorisable without a document lookup.
      //
      // Writes are the school's: AD, coach or staff of THIS school. `schoolId` is compared
      // against the path rather than read from the document, so the check cannot be fooled
      // by a document that names another school.
      match /recordStats/{statKey} {
        allow read: if signedIn();
        allow create, update: if signedIn() && (
          isAdOf(schoolId) || (role() in ['coach','staff'] && userData().schoolId == schoolId)
        );
        allow delete: if signedIn() && (
          isAdOf(schoolId) || (role() in ['coach','staff'] && userData().schoolId == schoolId)
        );
      }

      match /records/{recordId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && (
          isAdOf(schoolId) || (role() in ['coach','staff'] && userData().schoolId == schoolId)
        ) && request.resource.data.schoolId == schoolId;
        // A delete has no request.resource, so the stored document is what gets checked --
        // otherwise delete would be denied to everyone, and a wrong record would be
        // permanent.
        allow delete: if signedIn() && (
          isAdOf(schoolId) || (role() in ['coach','staff'] && userData().schoolId == schoolId)
        ) && resource.data.schoolId == schoolId;
      }

      match /playerClaimRequests/{requestId} {
        allow read: if signedIn() && (
          isAdOf(schoolId)
          || (role() in ['coach', 'staff'] && userData().schoolId == schoolId)
          || resource.data.requesterUserId == request.auth.uid
        );
        allow create, update, delete: if false;
      }
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      // `managerUserIds` is the Storage authorization index. It is written only by the
      // teamManagers Cloud Functions, which derive it from schools.adUserId and the
      // team's coach/staff membership rows. A client that could write it could grant
      // itself every file in the team's media, film and paperwork folders, so the field
      // is refused on create and immutable on update.
      allow create: if signedIn()
        && isAdOf(request.resource.data.get('schoolId', ''))
        && !('managerUserIds' in request.resource.data);
      // `schoolId` is ownership, not a label: it decides which school's AD holds power over
      // this team and which AD the manager index derives from. A client that could move a
      // team to another school could hand its files to a different AD — and, worse, leave
      // `managerUserIds` pointing at the old school until a trigger caught up. So the field
      // is immutable to clients too. Reassignment goes through the `reassignTeamSchool`
      // callable, which writes ownership and the index in one transaction. Unrelated fields
      // (name, season, colour, roster metadata) are untouched by this restriction.
      //
      // The immutability test is the DIFF, not the presence of the field. `request.resource`
      // is the whole post-write document, and every real team carries `managerUserIds` once
      // the index is built — so testing for its presence denied ordinary edits (a season
      // rename, a colour change) to every team that had ever been indexed.
      allow update: if canManageTeam(teamId)
        && !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['managerUserIds', 'schoolId']);
      // Deleting a team removes its whole season of data, so it stays with the AD
      // who owns that school — not any AD in the district.
      allow delete: if isAdOf(resource.data.get('schoolId', ''));

      match /members/{memberId} {
        allow read: if signedIn() && (uid() == memberId || isAdOf(teamSchool(teamId)) || isCoachOf(teamId));
        // Anyone may add themselves as a follower (follow a team).
        allow create: if canManageTeam(teamId)
          || (uid() == memberId && request.resource.data.role == 'follower');
        allow update, delete: if canManageTeam(teamId);
      }

      // Highlight studio — game film sources and produced highlight reels.
      // Viewers (including followers) can read; authors can write. Anyone
      // signed in may bump only the view counter by exactly one.
      match /videos/{videoId} {
        allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || memberRole(teamId) == 'follower');
        allow write: if canManageTeam(teamId) || isStaffOf(teamId);
      }

      match /reels/{reelId} {
        allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || memberRole(teamId) == 'follower');
        // 20 clips is the reel limit the app shows; enforced here too so a
        // modified client cannot store a 200-clip reel that no renderer will
        // accept and no viewer will watch.
        allow create: if (canManageTeam(teamId) || isStaffOf(teamId))
          && request.resource.data.clips.size() <= 20;
        allow delete: if canManageTeam(teamId) || isStaffOf(teamId);
        allow update: if ((canManageTeam(teamId) || isStaffOf(teamId))
            && (request.resource.data.clips.size() <= 20
                // An older reel may already be over the limit; allow it to be
                // trimmed back down, otherwise it is stuck and cannot be fixed.
                || request.resource.data.clips.size() < resource.data.clips.size()))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
              && request.resource.data.views == resource.data.views + 1);
      }

      match /roster/{entryId} {
        // Roster entries carry injury status, body part and clearance notes, plus
        // every family's phone and email. Document-level rules cannot hide fields, so
        // the only way to keep a player from reading a teammate's injury is to stop
        // them reading the teammate's entry at all.
        //
        // Staff see the whole roster. Everyone else sees ONLY what names them: an
        // athlete their own entry (matched on userId), a parent the entries whose
        // guardianUserIds include them. Players and parents previously came in through
        // isTeamMember, which handed them every other child's medical notes.
        allow read: if signedIn() && (
          isAdOf(teamSchool(teamId)) || isCoachOf(teamId) || isStaffOf(teamId)
          || request.auth.uid == resource.data.userId
          || request.auth.uid in resource.data.guardianUserIds
        );
        allow write: if canManageTeam(teamId);
        // Deliberately NO guardian write here. The school owns the player profile: a
        // guardian REQUESTS changes to player information, and edits their own contact
        // details on their own user document. An earlier whitelist let guardians write
        // parentName, parentPhone, allergies and medical notes onto this entry, which
        // both breached school ownership and duplicated guardian contact onto the
        // player record. Family-supplied safety data belongs on the player profile as a
        // staff-approved field, not on a record a family can silently rewrite.
        // Injury history is staff-only; writes go through Cloud Functions.
        match /injuryReports/{reportId} {
          allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isCoachOf(teamId) || isStaffOf(teamId));
          allow write: if false;
        }

        match /forms/{formId} {
          // A guardian reads their own athlete's requirements even though their
          // team membership is `follower`: without this the portal can see the
          // child but never the paperwork, which is the portal's whole purpose.
          allow read: if signedIn() && (
            isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || isGuardianOf(teamId, entryId)
          );
          allow write: if signedIn() && (
            canManageTeam(teamId)
            || staffHasPerm(teamId, 'forms')
            || (isGuardianOf(teamId, entryId) && request.resource.data.status == 'submitted')
          );
          // Dual signature. A player may e-sign their own part without touching
          // anything else, and may only COMPLETE the form when it does not require a
          // guardian signature or the guardian has already signed. The gate reads
          // requiresParentSignature from the STORED document, so a player cannot
          // clear the requirement in the same write that satisfies it.
          allow update: if signedIn() && isAthleteSelf(teamId, entryId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'playerSignedByName', 'playerSignedAt', 'playerSignedBy', 'status', 'updatedAt'
            ])
            && request.resource.data.status in ['missing', 'submitted']
            // The guardian gate applies only when the player is COMPLETING the form.
            // Applied to every write it stopped a player signing their own part while
            // waiting on a guardian, which is exactly the half-signed state that must
            // be allowed.
            && (
              request.resource.data.status != 'submitted'
              || resource.data.requiresParentSignature != true
              || ('signedByName' in request.resource.data && request.resource.data.signedByName != '')
            );
        }
      }

      match /forms/{formId} {
        allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isTeamMember(teamId));
        allow create: if canManageTeam(teamId) || staffHasPerm(teamId, 'forms');
        allow update, delete: if canManageTeam(teamId) || staffHasPerm(teamId, 'forms');

        match /submissions/{entryId} {
          allow read: if signedIn() && (
            isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || isGuardianOf(teamId, entryId)
          );
          allow write: if signedIn() && (
            canManageTeam(teamId)
            || staffHasPerm(teamId, 'forms')
            || (isGuardianOf(teamId, entryId) && request.resource.data.status == 'submitted')
          );
        }
      }

      // Join-by-code requests. Created ONLY by the requestTeamJoin callable, so a
      // client can never mint one; the requester can see their own, and the coach or
      // AD can read and resolve the queue. Approval itself is a coach action.
      match /joinRequests/{requestId} {
        allow read: if signedIn() && (
          isAdOf(teamSchool(teamId)) || isCoachOf(teamId) || resource.data.requesterUserId == request.auth.uid
        );
        allow create, delete: if false;
        allow update: if signedIn() && (isAdOf(teamSchool(teamId)) || isCoachOf(teamId));
      }

      match /volunteerShifts/{shiftId} {
        allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || memberRole(teamId) == 'follower');
        allow create: if canManageTeam(teamId) || staffHasPerm(teamId, 'concessions');
        allow update, delete: if canManageTeam(teamId) || staffHasPerm(teamId, 'concessions');

        match /signups/{userId} {
          allow read: if signedIn() && (isAdOf(teamSchool(teamId)) || isTeamMember(teamId) || memberRole(teamId) == 'follower');
          // Sign-ups are created only through the atomic `volunteerSignUp` Cloud Function.
          allow create: if false;
          allow delete: if signedIn() && (request.auth.uid == userId || canManageTeam(teamId) || staffHasPerm(teamId, 'concessions'));
          allow update: if false;
        }
      }

      match /media/{mediaId} {
        allow read: if signedIn();
        allow create: if canManageTeam(teamId) || isStaffOf(teamId);
        allow delete: if canManageTeam(teamId) || isStaffOf(teamId);
        allow update: if false;
      }
    }

    match /events/{eventId} {
      // Followers see the team calendar except practice details (item F).
      allow read: if signedIn() && (isAdOf(teamSchool(eventTeam(eventId))) || isTeamMember(resource.data.teamId)
        || (memberRole(resource.data.teamId) == 'follower'
            && resource.data.type in ['game', 'meeting', 'meal', 'travel']));
      // `request.resource` is null on a delete, so a rule that reads it can never
      // allow one: every event was permanent, and a mistyped practice could not be
      // removed. Delete authorises on the STORED team, and through that team's school
      // rather than a bare `isAdOf(teamSchool(eventTeam(eventId)))` -- enabling deletes must not hand every AD the
      // district's calendar.
      //
      // Create and update keep `canManageTeam`, whose AD branch is still school-blind
      // (task 2.3): tightening it here would also lock ADs out of legacy teams that
      // carry no `schoolId`, and that change belongs with its own tests.
      allow create, update: if canManageTeam(request.resource.data.get('teamId', ''));
      allow delete: if signedIn() && (
        isAdOf(teamSchool(resource.data.get('teamId', '')))
        || isCoachOf(resource.data.get('teamId', ''))
      );

      match /rsvps/{rsvpUserId} {
        // A family must answer for each child separately, so a guardian's document
        // is keyed `${uid}__${rosterEntryId}` and the authority is the
        // respondentUserId field. One answer per account (the original shape) made
        // a parent with two athletes on one team answer for only one of them.
        // Legacy documents (id == uid, field userId) stay valid so iOS is unchanged.
        // Self-service answers belong to people ON that team. Without the membership
        // gate, any signed-in account -- another school's AD included -- could write
        // an RSVP into any event in the district by naming itself the respondent,
        // because the only test was "does this document name me".
        allow read: if signedIn() && (
          isAdOf(teamSchool(eventTeam(eventId)))
          || isCoachOf(eventTeam(eventId))
          || (isTeamMember(eventTeam(eventId)) && (
               uid() == rsvpUserId
               || ('respondentUserId' in resource.data && resource.data.respondentUserId == uid())
             ))
        );
        allow write: if signedIn() && (
          isAdOf(teamSchool(eventTeam(eventId)))
          || isCoachOf(eventTeam(eventId))
          || (isTeamMember(eventTeam(eventId)) && (
               (uid() == rsvpUserId && request.resource.data.userId == uid())
               || ('respondentUserId' in request.resource.data
                   && request.resource.data.respondentUserId == uid())
             ))
        );
      }

      // Attendance: one document per roster entry, keyed by the roster entry id so it can
      // be joined to an athlete without a second lookup.
      //
      // This rule was MISSING. iOS has had setAttendance()/fetchAttendance() since the
      // start, writing events/{id}/attendance/{rosterEntryId}, and every one of those
      // writes was denied -- which is why the feature looked like it did not exist.
      //
      // read: staff, coach and AD see the event's attendance. A player or guardian does
      // NOT read this subcollection directly -- `users.linkedPlayerIds` is client-writable
      // (see the note further up this file), so trusting it here would let any guardian
      // add any roster entry id and read another child's record. Their own attendance is
      // served through a callable instead, where the link can be trusted.
      match /attendance/{rosterEntryId} {
        allow read: if signedIn() && (
          isAdOf(teamSchool(eventTeam(eventId)))
          || isCoachOf(eventTeam(eventId))
          || isStaffOf(eventTeam(eventId))
        );
        // Whoever runs the event takes attendance: coach, staff with the roster duty, or
        // the AD. Never the athlete, so attendance cannot be self-reported.
        allow write: if canManageTeam(eventTeam(eventId)) || isStaffOf(eventTeam(eventId));
      }

      match /attendance/{entryId} {
        allow read: if signedIn() && (isAdOf(teamSchool(eventTeam(eventId))) || isCoachOf(eventTeam(eventId)) || staffHasPerm(eventTeam(eventId), 'attendance'));
        allow write: if signedIn() && (isAdOf(teamSchool(eventTeam(eventId))) || isCoachOf(eventTeam(eventId)) || staffHasPerm(eventTeam(eventId), 'attendance'));
      }

      // Travel & pickup. A guardian declares how their own athlete is getting
      // home; choosing another parent from the team list IS the consent, so no
      // separate authorised-adult registry exists. Staff can read the manifest.
      match /releasePlans/{entryId} {
        allow read: if signedIn() && (
          isAdOf(teamSchool(eventTeam(eventId)))
          || isCoachOf(eventTeam(eventId))
          || staffHasPerm(eventTeam(eventId), 'attendance')
          || isGuardianOf(eventTeam(eventId), entryId)
        );
        // Guardians write their own athlete's plan. Staff changes go through the
        // setReleasePlanOverride callable so they always carry a reason and land
        // in the audit log — a coach silently changing a child's destination is
        // exactly what must be recorded.
        allow write: if signedIn() && isGuardianOf(eventTeam(eventId), entryId);
      }

      // The handoff record. Written only by confirmRelease / reopenRelease, so a
      // release cannot be forged or erased from a client.
      match /releases/{entryId} {
        allow read: if signedIn() && (
          isAdOf(teamSchool(eventTeam(eventId)))
          || isCoachOf(eventTeam(eventId))
          || staffHasPerm(eventTeam(eventId), 'attendance')
          || isGuardianOf(eventTeam(eventId), entryId)
        );
        allow write: if false;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn() && canManageTeam(request.resource.data.teamId);
      allow update, delete: if canManageTeam(resource.data.teamId)
        || staffHasPerm(resource.data.teamId, 'statistician')
        || isGameScorer(gameId);

      match /stats/{entryId} {
        allow read: if signedIn();
        allow write: if isAdOf(teamSchool(gameTeam(gameId))) || isCoachOf(gameTeam(gameId))
          || staffHasPerm(gameTeam(gameId), 'statistician')
          || isGameScorer(gameId);
      }

      // Per-game scoring grants. Written only by claimGameStatistician.
      match /scorers/{scorerId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Play by play. Readable by any signed-in user so a follower can watch the
      // game unfold; written only by the people allowed to score it.
      match /plays/{playId} {
        allow read: if signedIn();
        allow create, delete: if isAdOf(teamSchool(gameTeam(gameId))) || isCoachOf(gameTeam(gameId))
          || staffHasPerm(gameTeam(gameId), 'statistician')
          || isGameScorer(gameId);
      }
    }

    // Organization-owned assets (facilities, fields, buses) and their bookings.
    // Clients can read so coaches can see availability; every write goes through
    // the booking callables, which enforce no-overlap inside a transaction.
    match /resources/{resourceId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /resourceBookings/{bookingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Verified career ledger. Written by verifyGameStats when a game's stats are
    // confirmed, and cleared by reopenGameStats; nobody may write from a client.
    // Staff of the school may read it.
    match /careerStatLines/{lineId} {
      allow read: if signedIn() && role() in ['ad','coach','staff']
        && 'schoolId' in resource.data
        && resource.data.schoolId == userData().schoolId;
      allow write: if false;
    }

    // Record-chase announcements already sent. Server-written only, so the
    // daily job can de-duplicate and nobody can suppress or forge a notice.
    match /recordChaseAnnouncements/{docId} {
      allow read: if signedIn() && role() in ['ad','coach','staff']
        && 'schoolId' in resource.data
        && resource.data.schoolId == userData().schoolId;
      allow write: if false;
    }

    // School records are part of the public story of a program. Nothing in the app
    // writes them: a record is seeded with the Admin SDK, and the daily record-chase
    // job is the only reader.
    match /schoolRecords/{recordId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // A coach asking for a volunteer to run one game's scoring. Team members can
    // see the request; only the Cloud Functions may create, fill or cancel it.
    match /gameStatisticianRequests/{requestId} {
      allow read: if signedIn() && (
        isAdOf(teamSchool(resource.data.get('teamId', '')))
        || isCoachOf(resource.data.teamId)
        || isTeamMember(resource.data.teamId)
      );
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && chatReadAllowed(resource.data.type, resource.data.teamId);
      allow create: if signedIn() && canManageTeam(request.resource.data.teamId);
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && messageReadAllowed(chatDoc(chatId).type, chatDoc(chatId).teamId);
        allow create: if signedIn() && chatWriteAllowed(chatDoc(chatId).type, chatDoc(chatId).teamId);
        // Moderation: an AD or the team's coach may hide a message, and only
        // those fields. Content is never destroyed — the audit trail stays.
        allow update: if signedIn()
          && (isAdOf(teamSchool(chatDoc(chatId).teamId)) || isCoachOf(chatDoc(chatId).teamId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hidden', 'moderatedBy', 'moderatedAt']);
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in conversationDoc(conversationId).participantIds;
        allow create: if signedIn() && request.auth.uid in conversationDoc(conversationId).participantIds;
        allow update, delete: if false;
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow create: if signedIn() && canManageTeam(request.resource.data.teamId);
      allow update, delete: if canManageTeam(resource.data.teamId);
    }

    // Trips carry `teamId` and no `schoolId` (iOS writes the document directly), so
    // their school is resolved through the team. A team with no `schoolId` grants its
    // AD nothing here -- deny is the safe default for a legacy record.
    //
    // Delete reads the STORED document: the old rule read `request.resource`, which is
    // null on a delete, so no trip could ever be removed.
    match /trips/{tripId} {
      allow read: if signedIn() && (
        isAdOf(teamSchool(resource.data.get('teamId', '')))
        || isTeamMember(resource.data.get('teamId', ''))
      );
      allow create, update: if signedIn() && (
        isAdOf(teamSchool(request.resource.data.get('teamId', '')))
        || isCoachOf(request.resource.data.get('teamId', ''))
      );
      allow delete: if signedIn() && (
        isAdOf(teamSchool(resource.data.get('teamId', '')))
        || isCoachOf(resource.data.get('teamId', ''))
      );
    }

    match /fundraisers/{fundraiserId} {
      // A fundraiser is public-facing by design -- a donor follows a link -- so read
      // stays open to any signed-in account. Writes are the owning school's.
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        isAdOf(teamSchool(request.resource.data.get('teamId', '')))
        || isCoachOf(request.resource.data.get('teamId', ''))
        || staffHasPerm(request.resource.data.get('teamId', ''), 'fundraising')
      );
      // Delete reads the stored document; `request.resource` is null here, which made
      // every fundraiser permanent.
      allow delete: if signedIn() && (
        isAdOf(teamSchool(resource.data.get('teamId', '')))
        || isCoachOf(resource.data.get('teamId', ''))
        || staffHasPerm(resource.data.get('teamId', ''), 'fundraising')
      );

      match /donations/{donationId} {
        allow read: if signedIn() && (
          isAdOf(teamSchool(fundTeam(fundraiserId)))
          || isCoachOf(fundTeam(fundraiserId))
          || isStaffOf(fundTeam(fundraiserId))
        );
        allow create: if signedIn();
        allow update, delete: if false;
      }

      match /progress/{entryId} {
        allow read: if signedIn();
        allow write: if signedIn() && (
          isAdOf(teamSchool(fundTeam(fundraiserId)))
          || isCoachOf(fundTeam(fundraiserId))
          || staffHasPerm(fundTeam(fundraiserId), 'fundraising')
          || isRosterAssignee(fundTeam(fundraiserId), entryId)
        );
      }
    }

    // A recruiting card carries a minor's GPA and bio. This read used to be open to any
    // signed-in account, and `games/{id}/plays` publishes the rosterEntryId that keys
    // these documents -- so any parent in any district could walk from a scoreboard to a
    // child's transcript. Read is now the athlete, their guardian, their own team's
    // people, and the AD who owns that team's school.
    match /showcases/{showcaseId} {
      allow read: if signedIn() && (
        isRosterAssignee(resource.data.teamId, resource.data.rosterEntryId)
        || isTeamMember(resource.data.get('teamId', ''))
        || isAdOf(teamSchool(resource.data.get('teamId', '')))
      );
      // Owned by the athlete and their linked parent/guardian — never staff.
      allow create: if signedIn() && isRosterAssignee(request.resource.data.teamId, request.resource.data.rosterEntryId);
      allow update: if signedIn() && isRosterAssignee(resource.data.teamId, resource.data.rosterEntryId);
      allow delete: if false;

      // Highlights are the clips behind an unpublished card: same audience as the card.
      match /highlights/{highlightId} {
        allow read: if signedIn() && (
          isTeamMember(showcaseTeam(showcaseId))
          || isAdOf(teamSchool(showcaseTeam(showcaseId)))
        );
        allow write: if false;
      }
    }

    // Moderation queue. Written only by the reportContent Cloud Function.
    //
    // That function stores `teamId` and no `schoolId`, so the school is resolved
    // through the team. A report with no team (a profile report) resolves to '' and is
    // readable by nobody through this path: no school owns it. The alternative was
    // every AD reading every district's moderation queue.
    match /reports/{reportId} {
      allow read: if signedIn() && isAdOf(teamSchool(resource.data.get('teamId', '')));
      allow write: if false;
    }

    // Audit trail of deleted accounts (no PII). Server-write only.
    match /deletedAccounts/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /invitations/{invitationId} {
      // Previously world-readable to any signed-in user, which exposed every
      // school's parent email addresses and invite codes. Scoped to the people
      // with a legitimate reason to see a given invitation.
      allow read: if signedIn() && (
        // The invitee themselves, matched against their verified token email.
        (request.auth.token.email != null
          && 'email' in resource.data
          && resource.data.email == request.auth.token.email.lower())
        // The AD of the school the INVITATION names, not of the caller's own.
        || isAdOf(resource.data.get('schoolId', ''))
        // The team's coach or staff, for their own team only.
        || ('teamId' in resource.data && (isCoachOf(resource.data.teamId) || isStaffOf(resource.data.teamId)))
      );
      // AD invitations carry ownership of the school, so they are minted by the
      // Cloud Function (which verifies the caller owns it), never by a client.
      allow create: if signedIn() && request.resource.data.role != 'ad'
        && (isAdOf(request.resource.data.get('schoolId', ''))
          || ('teamId' in request.resource.data && isCoachOf(request.resource.data.teamId)));
      allow update, delete: if signedIn() && (
        isAdOf(resource.data.get('schoolId', ''))
        || ('teamId' in resource.data && isCoachOf(resource.data.teamId))
      );
    }

    // Append-only audit trail. Written exclusively by Cloud Functions via the
    // Admin SDK, so no client can forge or erase an entry. An AD may read their
    // own school's entries and nothing else.
    match /auditLogs/{logId} {
      allow read: if signedIn() && isAdOf(resource.data.get('schoolId', ''));
      allow write: if false;
    }
  }
}
