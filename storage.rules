rules_version = '2';

// RockLab Athletics storage rules.
// Paths:
//   users/{uid}/photo.jpg              profile photo
//   schools/{schoolId}/logo.jpg        school logo
//   teams/{teamId}/media/{file}        team photos
//   teams/{teamId}/videos/{file}       game film / highlight sources
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    /// Authorisation reads the SAME source as firestore.rules: the user document.
    ///
    /// This used to read `request.auth.token.role`. Custom claims are refreshed only
    /// when the token is minted, so a demoted or re-scoped account kept Storage
    /// access Firestore would already refuse. Reading the document removes the drift
    /// by construction, at the cost of one lookup per check.
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function role() { return userData().role; }

    function mySchoolId() {
      return ('schoolId' in userData() && userData().schoolId is string) ? userData().schoolId : '';
    }

    /// AD standing requires OWNING the school, mirroring firestore.rules.
    ///
    /// One lookup, not two: `exists()` then `get()` on the same document cost double the
    /// budget for no extra information, because `get()` on a missing document already
    /// yields null and fails the comparison. The budget is TWO documents per evaluation.
    function ownsSchool() {
      let schoolId = mySchoolId();
      return signedIn()
        && schoolId != ''
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.adUserId
             == request.auth.uid;
    }

    // There is deliberately no `isAd()` here any more.
    //
    // It answered "am I the AD of SOME school", and pairing it with `isSchoolAd(schoolId)`
    // meant the FIRST disjunct decided: any AD could write any other school's logo, any
    // team's photos and film, and any athlete's paperwork. Team paths now resolve through
    // `isManagerOf(teamId)`, whose index is derived per team and cannot contain an AD of
    // another school; school logos keep `isSchoolAd(schoolId)`.

    /// The team document, read at most ONCE per evaluation.
    ///
    /// Cloud Storage Security Rules may access **two** Firestore documents per
    /// evaluation (firebase.google.com/docs/storage/security/rules-conditions). That is
    /// the constraint this whole file is shaped around: resolving "is the caller an AD of
    /// the school that owns this team" the direct way costs three documents
    /// (users + teams + schools), so every legitimate AD was denied on media, film and
    /// paperwork — measured on a real bucket, not theorised.
    ///
    /// `teams/{teamId}.managerUserIds` is therefore the authorization record for
    /// management, maintained only by Cloud Functions (functions/teamManagers.js) from
    /// `teams.schoolId`, `schools.adUserId` and coach/staff membership rows. Firestore
    /// rules forbid a client from writing it.
    function teamData(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
    }

    /// Manager standing over THIS team. One document, and a team with no schoolId has an
    /// empty list because the server never derived an AD for it — fail-closed by
    /// construction rather than by an extra lookup.
    function isManagerOf(teamId) {
      let t = teamData(teamId);
      return signedIn()
        && t != null
        && 'managerUserIds' in t
        && t.managerUserIds is list
        && t.managerUserIds.hasAny([request.auth.uid]);
    }

    /// One document, one call: `get()` on a missing membership already yields null, so
    /// pairing it with `exists()` would spend the second half of the budget for nothing.
    function membership(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data;
    }

    function memberRole(teamId) {
      let m = membership(teamId);
      return m == null ? null : m.role;
    }

    function isTeamMember(teamId) {
      return memberRole(teamId) in ['coach', 'staff', 'player', 'parent'];
    }

    function isFollower(teamId) { return memberRole(teamId) == 'follower'; }
    function isCoachOf(teamId) { return memberRole(teamId) in ['coach', 'staff']; }

    function isSchoolAd(schoolId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.adUserId
             == request.auth.uid;
    }

    // Profile photos: only the owner writes; anyone signed in can read.
    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // School logos: the AD of that school.
    //
    // A logo is replaced far more often than it is created -- a school changes its mark,
    // or the first upload is the wrong file -- so delete is allowed on the same terms.
    // Metadata-only updates carry no `request.resource.size`, so the size check is
    // written so it cannot deny an operation that never had a body.
    match /schools/{schoolId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isSchoolAd(schoolId)
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if signedIn() && isSchoolAd(schoolId);
    }

    // Team photos: members can view, staff/coaches can manage.
    match /teams/{teamId}/media/{fileName} {
      // Manager: one document (the team). Member: two (team, then membership).
      allow read: if signedIn()
        && (isManagerOf(teamId) || isTeamMember(teamId) || isFollower(teamId));
      // Write and delete are index-only on purpose. The index is rebuilt by Cloud
      // Functions whenever a membership row or the team changes, so revoking a coach is
      // one document write away and cannot leave a stale membership row granting access.
      allow write: if isManagerOf(teamId)
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isManagerOf(teamId);
    }

    // Game film: same audience, larger cap. 4 GB matches maxUploadBytes in
    // HighlightService - a full 1080p game is roughly 2 GB, so a smaller cap
    // would reject the very footage this feature exists for.
    match /teams/{teamId}/videos/{fileName} {
      allow read: if signedIn()
        && (isManagerOf(teamId) || isTeamMember(teamId) || isFollower(teamId));
      allow write: if isManagerOf(teamId)
        && request.resource.size < 4096 * 1024 * 1024;
      allow delete: if isManagerOf(teamId);
    }

    // Athlete paperwork: physicals, code-of-conduct returns, clearance letters.
    //
    // Scoped to the ROSTER ENTRY, not the team, so "the guardian of this child" is
    // expressible. `guardianUserIds` is the authority: acceptInvitation and
    // approveParentLink write it server-side, and roster entries are writable only by
    // coaches and ADs. `users.linkedPlayerIds` is deliberately NOT consulted — it is
    // client-writable, so trusting it here would let any account claim a child.
    //
    // Read: the guardian of that entry, or staff. Never a follower, and never a
    // teammate — a 10 MB PDF of someone else's medical record is the worst thing this
    // bucket could leak.
    //
    // Write: same people, ≤10 MB, and only the three types a phone camera or a school
    // office produces. `request.resource.contentType` is declared by the client, but
    // Storage verifies it against the uploaded bytes.
    match /teams/{teamId}/roster/{entryId}/documents/{fileName} {
      function guardianOfEntry() {
        return signedIn() && firestore.get(
          /databases/(default)/documents/teams/$(teamId)/roster/$(entryId)
        ).data.guardianUserIds.hasAny([request.auth.uid]);
      }

      // Manager: one document. Guardian: one document. Neither branch can spend the
      // other's budget, which is why the manager/guardian split is expressed as two
      // single-lookup clauses rather than a chain of three.
      allow read: if signedIn() && (isManagerOf(teamId) || guardianOfEntry());

      // The rules language has no ternary: one conjunction, so a write by anyone
      // outside these two groups is refused by the first clause alone.
      //
      // A family may ADD a document but never REPLACE one. `create` fires only when no
      // object exists at the path; `update` fires when one does. A file a coach has
      // already reviewed must not change underneath the review, and Storage cannot ask
      // whether it was reviewed. This does not strand a family that uploaded the wrong
      // file: the portal names each upload `${Date.now()}-${name}`, so a re-upload
      // lands at a new path and staff can compare both. Overwrite stays a staff power.
      //
      // Note for whoever verifies this: the Storage emulator reports every upload as
      // `create`, so this distinction cannot be probed locally. It has to be checked
      // against the deployed rules in Phase 4.3, with the versioned-document fix, which
      // is the part that actually makes a reviewed file immutable.
      allow create: if (isManagerOf(teamId) || guardianOfEntry())
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png');

      allow update: if isManagerOf(teamId)
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png');

      allow delete: if signedIn() && (isManagerOf(teamId) || guardianOfEntry());
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
