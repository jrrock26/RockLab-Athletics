# --- Email (invitations) -------------------------------------------------
# Without these, invitations are still created but NO email is sent, and the
# invitation document is stamped deliveryStatus = "not_configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Billing (Stripe) ----------------------------------------------------
# Schools subscribe on the web console only. iOS never sells (App Store 3.1.1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_DISTRICT=
