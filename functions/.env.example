# --- Email (invitations) -------------------------------------------------
# Without these, invitations are still created but NO email is sent, and the
# invitation document is stamped deliveryStatus = "not_configured".
#
# Preferred: Resend. One API key, no SMTP host/port to get right.
RESEND_API_KEY=
RESEND_FROM=RockLab Athletics <invites@mail.rocklabathletics.com>

# Fallback: SMTP (Google Workspace, Postmark, SendGrid...).
# For Google Workspace, SMTP_PASS is a 16-character App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Links used inside the invitation email.
PUBLIC_WEB_BASE=https://rocklab-athletics.web.app

# --- Billing (Stripe) ----------------------------------------------------
# Schools subscribe on the web console only. iOS never sells (App Store 3.1.1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_DISTRICT=
